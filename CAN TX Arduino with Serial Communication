void serialUDS() {
//reads and stores the byte array size, is required for padding
//in case message is shorter than 10 bytes. The serial communication will not send anything more
//than 11 bits CAN frame identifier + 8 bytes. 
  CanFrame UDSFrame = { 0 };// all array is initialized to 0s, so stuffing is automatically done if no input is received in that location.
  //UDSFrame.identifier = 0x7DF; // Sets the ID in this case the sending request as a transmitter
  UDSFrame.extd = 0; // Set extended frame to false since we're doing 8-bit or standard CAN
  UDSFrame.data_length_code = 8; // Set length of data - change depending on data sent.
  
    if(Serial.available() > 0) { //reads if there is data on terminal
      UDSRequest=Serial.readString();
      Serial.println(UDSRequest);
        while ((spaceIndex = UDSRequest.indexOf(' ', startIndex)) != -1) {
        String word = UDSRequest.substring(startIndex, spaceIndex);  // Extract word
          if (counter==0)
          {
            uint16_t num = (uint16_t) strtol(word.c_str(), NULL, 16);
            UDSFrame.identifier = num;// Sets the ID in this case the sending request as a transmitter
          }
          else
          {
            byte Hexframe = (byte) strtol(word.c_str(), NULL, 16);
            UDSFrame.data[counter-1] = Hexframe;
          }
        startIndex = spaceIndex + 1;  // Move to the next word
        counter++;
  }
      
      ESP32Can.writeFrame(UDSFrame);
      counter=0; 
      startIndex=0;
  }                  
  delay(500);  
}

